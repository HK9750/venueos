APP_ENV=development
APP_SERVICE_NAME=venueos
HTTP_ADDRESS=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
DATABASE_URL=postgres://venueos:venueos@localhost:5432/venueos?sslmode=disable
DATABASE_CONNECT_TIMEOUT=10s
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
LOG_LEVEL=info
LOG_FORMAT=text
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLE_RATE=1
METRICS_ENABLED=true
PPROF_ENABLED=false
ADMIN_ADDRESS=127.0.0.1:9090
WORKER_INTERVAL=30s
